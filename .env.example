# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Local dev: Homebrew Postgres. Production: Neon (use the pooled URL).
# Consumed by BOTH the Prisma CLI (copy to packages/db/.env) and the
# Next app runtime (copy to apps/web/.env.local).
DATABASE_URL="postgresql://USER@localhost:5432/localfirstdocs?schema=public"

# ─── Auth.js (NextAuth v5) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true

# ─── Realtime collaboration server (Hocuspocus) ─────────────────────────
# Dev: ws://localhost:1234   Prod: wss://<your-render-service>.onrender.com
NEXT_PUBLIC_WS_URL="ws://localhost:1234"

# Shared HMAC secret for the short-lived WS handshake token. MUST be identical
# in the Next app and the collab server. Generate with: openssl rand -base64 32
COLLAB_TOKEN_SECRET="replace-me"

# ─── AI (Groq) — powers the "Explain what changed" version-diff feature ─────
# Free key from https://console.groq.com/keys. Optional: the feature degrades
# gracefully (shows a "not configured" message) if this is unset.
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"   # optional override
